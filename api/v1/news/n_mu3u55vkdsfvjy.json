.shtml","cover":"./img/news/a-n_mu5165okfkgioy-cover.jpg","video":null,"gallery":[],"status":"published","flags":{"headline":false,"hot":false,"blast":false,"focus":true,"top":false,"headlineOrder":0,"recommend":7},"stats":{"views":1,"likes":0,"comments":0,"shares":0,"favs":0,"deltaViews":1,"deltaLikes":0},"publishedAt":"2026-09-17T04:16:31.000Z","scheduledAt":"","origin":"pipeline","inboxId":"mu514zuvj5bahe","channelName":"国内","hasVideo":false,"imageCount":1,"hotScore":0.09},{"id":"n_mu5165pa0c1wnx","createdAt":"2026-09-17T04:29:38.014Z","updatedAt":"2026-09-18T14:34:36.645Z","title":"国际最新研究：人脑类器官在小鼠体内形成神经网络","subtitle":"","summary":"中新网北京9月17日电 (记者 孙自法)国际学术期刊《自然》最新发表一篇神经科学研究论文表明，移植到小鼠体内的人脑类器官(由人类细胞培养形成的三维类脑组织)能够重现大脑发育的某些特征，包括形成功能性神经网络，从而支持脑活","channel":"china","tags":["国内","国际最新研究","人脑类器官"],"author":"中新网·滚动","source":"中新网·滚动","sourceUrl":"https://www.chinanews.com.cn/gj/2026/09-17/10698074.shtml","cover":"./img/news/a-n_mu5165pa0c1wnx-cover.jpg","video":null,"gallery":[],"status":"published","flags":{"headline":false,"hot":false,"blast":false,"focus":false,"top":false,"headlineOrder":0,"recommend":7},"stats":{"views":1,"likes":0,"comments":0,"shares":0,"favs":0,"deltaViews":1,"deltaLikes":0},"publishedAt":"2026-09-17T04:14:47.000Z","scheduledAt":"","origin":"pipeline","inboxId":"mu514zv9evvh5m","channelName":"国内","hasVideo":false,"imageCount":1,"hotScore":0.09}]}}